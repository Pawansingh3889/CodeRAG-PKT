# Copy this file to .env:
#   cp .env.example .env
#
# --- Embeddings ---
# Default is "local": sentence-transformers/all-MiniLM-L6-v2, runs on your
# own machine, $0, no key needed. First run downloads the model (~90MB)
# and pulls in torch as a dependency (via requirements.txt), that's the
# real cost of "free" here: disk space and one-time download, not money.
EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# To use OpenAI's embeddings instead (text-embedding-3-small, a fraction
# of a cent per repo-sized index), set EMBEDDING_PROVIDER=openai and:
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# --- Generation ---
# Defaults to OpenAI (gpt-4o-mini) if CHAT_BASE_URL/CHAT_API_KEY are unset.
# To use Groq's free tier instead:
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_API_KEY=<your Groq key>
# CHAT_MODEL=openai/gpt-oss-20b
CHAT_MODEL=gpt-4o-mini
